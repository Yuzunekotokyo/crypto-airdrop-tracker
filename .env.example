# ===== Gmail送信設定 =====
# Gmailアプリパスワードを使用 (2段階認証必須)
# 取得方法: Googleアカウント → セキュリティ → アプリパスワード
GMAIL_SENDER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
GMAIL_RECIPIENT=tsukamoto.kei@gmail.com

# ===== CoinGecko API =====
# 無料プランはAPIキー不要 (レート制限あり)
# Pro版: https://www.coingecko.com/en/api
COINGECKO_API_KEY=

# ===== 更新スケジュール =====
# 毎日この時刻に自動更新 + メール送信
UPDATE_HOUR=8
UPDATE_MINUTE=0
