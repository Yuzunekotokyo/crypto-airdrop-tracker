# Gmail送信設定 (どちらか一方を選択)
# --- 方法1: Gmailアプリパスワード (簡単) ---
GMAIL_SENDER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
GMAIL_RECIPIENT=tsukamoto.kei@gmail.com

# --- 方法2: Gmail API OAuth2 (推奨) ---
# GOOGLE_CREDENTIALS_FILE=credentials.json
# GOOGLE_TOKEN_FILE=token.json

# CoinGecko API (無料プランはAPIキー不要)
COINGECKO_API_KEY=

# 更新スケジュール (cron形式, デフォルト: 毎日午前8時)
UPDATE_HOUR=8
UPDATE_MINUTE=0

# --- 週足コンフルエンス・シグナル (フィボ0.5 + 週足基準線 + 週足25MA) ---
SIGNAL_SYMBOLS=BTC            # カンマ区切りで複数可 (例: BTC,ETH)
SIGNAL_INTERVAL_MIN=15        # チェック間隔(分)
SIGNAL_CONFLUENCE_PCT=4       # 支持線同士がこの%以内に集まっていればゾーン成立
SIGNAL_MIN_LEVELS=3           # 何本重なればシグナルにするか (2 or 3)
SIGNAL_WATCH_PCT=3            # ゾーンまでこの%以内で「接近中」予告メール
SIGNAL_TOUCH_PCT=0.5          # ゾーン上限のこの%手前で「到達」とみなす誤差
SIGNAL_BREAK_PCT=2            # ゾーン下限をこの%割ったら「割れ」= 損切り目安
SIGNAL_COOLDOWN_HOURS=24      # 同じ種類の通知を再送しない時間
# フィボの起点/終点を手動固定 (空なら自動検出)。例: SIGNAL_SWING_LOW=57800
SIGNAL_SWING_LOW=
SIGNAL_SWING_HIGH=
